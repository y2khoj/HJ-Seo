<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/studio_sans</item>
        <item name="android:colorAccent">#E7F500</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0C0E11</item>
        <item name="android:statusBarColor">#0C0E11</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0C0E11</item>
        <item name="android:alertDialogTheme">@style/StudioAlertDialog</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="StudioAlertDialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/studio_sans</item>
        <item name="android:colorAccent">#E7F500</item>
        <item name="android:textColorPrimary">#F3F5F6</item>
        <item name="android:textColorSecondary">#9DA7B3</item>
        <item name="android:windowBackground">@drawable/dialog_surface</item>
    </style>
</resources>
